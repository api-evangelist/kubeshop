{
  "opencollection": "1.0.0",
  "info": {
    "name": "Testkube Standalone Agent api logs API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "logs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get execution's logs by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.testkube.io/executions/:id/logs",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "unique id of the object"
              }
            ]
          },
          "docs": "Returns logs of the given executionID"
        },
        {
          "info": {
            "name": "Get execution's logs by ID version 2",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.testkube.io/executions/:id/logs/v2",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "unique id of the object"
              }
            ]
          },
          "docs": "Returns logs of the given executionID version 2"
        }
      ]
    }
  ],
  "bundled": true
}