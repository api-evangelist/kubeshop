          "name": "List cluster resources",
          "request": {
            "name": "List cluster resources",
            "description": {
              "content": "Returns every Group/Version/Kind the cluster exposes, tagged with whether\nthe agent ServiceAccount has list+watch permission. Backs the UI dropdown\nfor picking what resource a TestTrigger or WorkflowTrigger should watch.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "cluster-resources"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "watchable",
                  "value": "<boolean>",
                  "description": "When true, drop resources the agent cannot list+watch."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
